
def alpha_beta(depth, node, maximizing, values, alpha, beta):
    if depth == 3:
        return values[node]

    if maximizing:
        best = float('-inf')

        for child in range(2):
            score = alpha_beta(
                depth + 1, node * 2 + child,
                False, values, alpha, beta
            )
            best = max(best, score)
            alpha = max(alpha, best)

            if beta <= alpha:
                break  # Prune remaining branches

        return best

    else:
        best = float('inf')

        for child in range(2):
            score = alpha_beta(
                depth + 1, node * 2 + child,
                True, values, alpha, beta
            )
            best = min(best, score)
            beta = min(beta, best)

            if beta <= alpha:
                break  # Prune remaining branches

        return best


# Leaf node evaluation scores
values = [3, 5, 6, 9, 1, 2, 0, -1]

result = alpha_beta(
    0, 0, True, values,
    float('-inf'), float('inf')
)

print("Optimal score:", result)
