
import heapq

def a_star_search(graph, heuristic, start, goal):
    pq = [(heuristic[start], 0, start, [start])]
    visited = set()

    while pq:
        f, g, current, path = heapq.heappop(pq)

        if current == goal:
            print("Optimal path:", " -> ".join(path))
            print("Total path cost:", g)
            return

        if current in visited:
            continue

        visited.add(current)

        for neighbor, cost in graph[current]:
            if neighbor not in visited:
                new_g = g + cost
                new_f = new_g + heuristic[neighbor]
                heapq.heappush(
                    pq, (new_f, new_g, neighbor, path + [neighbor])
                )

    print("No path found")

# Graph with actual travel costs
graph = {
    'A': [('B', 2), ('C', 4)],
    'B': [('D', 3), ('E', 5)],
    'C': [('E', 1)],
    'D': [('G', 4)],
    'E': [('G', 2)],
    'G': []
}

# Estimated distance to the destination G
heuristic = {
    'A': 6,
    'B': 5,
    'C': 3,
    'D': 4,
    'E': 2,
    'G': 0
}

start = 'A'
goal = 'G'

a_star_search(graph, heuristic, start, goal)
