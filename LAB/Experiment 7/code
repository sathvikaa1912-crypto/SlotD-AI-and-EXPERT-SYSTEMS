
def minimax(depth, node, maximizing, values):
    if depth == 0:
        return values[node]

    if maximizing:
        best = float('-inf')
        for child in range(2):
            score = minimax(depth - 1, node * 2 + child, False, values)
            best = max(best, score)
        return best

    else:
        best = float('inf')
        for child in range(2):
            score = minimax(depth - 1, node * 2 + child, True, values)
            best = min(best, score)
        return best

# Leaf node evaluation scores
values = [3, 5, 2, 9, 12, 5, 23, 1]

depth = 3
result = minimax(depth, 0, True, values)

print("Optimal score:", result)
